  "version": "0.2.0",
  "configurations": [
    {
      "name": "Flutter Chrome (Dev)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "deviceId": "chrome",
      "flutterMode": "debug",
      "toolArgs": ["--dart-define-from-file=firebase_env.json"]
    },
    {
      "name": "Flutter Chrome (Dev - main_dev)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main_dev.dart",
      "deviceId": "chrome",
      "flutterMode": "debug",
      "toolArgs": ["--dart-define-from-file=firebase_env.json"]
    },
    {
      "name": "Flutter Chrome (Release)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "deviceId": "chrome",
      "flutterMode": "release",
      "toolArgs": ["--dart-define-from-file=firebase_env.json"]
    }
  ]
}
